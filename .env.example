# Postgres connection for the `food` schema (copy to .env and fill in).
FOOD_DATABASE_URL=postgresql://nutrition:CHANGE-ME@127.0.0.1:5433/nutrition

# Optional: User-Agent sent to Open Food Facts
# OFF_USER_AGENT=mcp-food/1.0 (self-hosted)

# Optional: seconds to wait for an Open Food Facts request
# OFF_TIMEOUT_SECONDS=15

# Optional: log level (DEBUG, INFO, WARNING, ...)
# LOG_LEVEL=INFO
